@echo off
chcp 65001 >nul
title نظام التوزيع الذكي - Chatwoot Smart Router
color 0B

echo ======================================================================
echo           🚀 تشغيل نظام التوزيع الذكي ولوحة التحكم
echo ======================================================================
echo.

:: 1. تشغيل سيرفر النظام في الخلفية
echo [1/3] جاري تشغيل سيرفر النظام على منفذ 5005...
start "Chatwoot Server" "%~dp0Backend\run_backend.bat"

:: 2. الانتظار لثوانٍ للتأكد من قيام السيرفر
echo [2/3] جاري التحقق من جاهزية النظام...
timeout /t 4 >nul

:: 3. استخراج عنوان الـ IP المحلي لمشاركته مع أجهزة الشبكة
for /f "tokens=2 delims=:" %%a in ('ipconfig ^| findstr /c:"IPv4"') do (
    set "LOCAL_IP=%%a"
    goto :IP_FOUND
)
set "LOCAL_IP= localhost"

:IP_FOUND
set "LOCAL_IP=%LOCAL_IP: =%"

echo.
echo ======================================================================
echo  ✅ النظام شغال الآن بنجاح!
echo ----------------------------------------------------------------------
echo  🖥️ رابط الدخول من هذا الجهاز:
echo     👉 http://localhost:5005
echo.
echo  📱 رابط الدخول للشباب من أي جهاز أو موبايل على نفس الشبكة (Wi-Fi):
echo     👉 http://%LOCAL_IP%:5005
echo ======================================================================
echo.

:: 4. فتح اللوحة في المتصفح تلقائياً
echo [3/3] جاري فتح لوحة التحكم في المتصفح...
start http://localhost:5005

timeout /t 5 >nul
exit
