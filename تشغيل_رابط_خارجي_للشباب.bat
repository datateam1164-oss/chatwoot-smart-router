@echo off
chcp 65001 >nul
title رابط الوصول الخارجي للنظام (Online Access Link)
color 0B

echo ======================================================================
echo           🌐 جاري إنشاء رابط خارجي مؤمن (HTTPS) لمشاركة النظام
echo ======================================================================
echo.
echo [1] التأكد من تشغيل النظام المحلي أولاً...
echo.
curl -s http://localhost:5005/api/health >nul 2>&1
if %errorlevel% neq 0 (
    echo ⚠️ السيرفر المحلي غير شغال! جاري تشغيله تلقائياً...
    start "" "%~dp0تشغيل_النظام.bat"
    timeout /t 5 >nul
)

echo.
echo [2] جاري إنشاء رابط HTTPS عام للشباب والتيم...
echo     (يمكن لأي شخص الدخول باليوزر والباسورد الخاص به من الموبايل أو الكمبيوتر)
echo.
echo ======================================================================
echo.
npx --yes localtunnel --port 5005
pause
